{
    "window": {
        "title": "MonsterWar",
        "width": 1600,
        "height": 1216,
        "window_scale": 0.75,
        "logical_scale": 1.0,
        "resizable": true
    },
    "graphics": {
        "vsync": true
    },
    "performance": {
        "target_fps": 60
    },
    "audio": {
        "music_volume": 0.2,
        "sound_volume": 0.2
    },
    "input_mappings": {
        "Pause": [
            "P",
            "Escape"
        ],
        "MoveDown": [
            "S",
            "Down"
        ],
        "Jump": [
            "J",
            "Space"
        ],
        "MoveUp": [
            "W",
            "Up"
        ],
        "MoveRight": [
            "D",
            "Right"
        ],
        "Attack": [
            "K",
            "MouseLeft"
        ],
        "MoveLeft": [
            "A",
            "Left"
        ]
    }
}