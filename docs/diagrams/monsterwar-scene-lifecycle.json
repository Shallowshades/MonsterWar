    { "id": "terminal", "label": "终态" }
  ],
  "states": [
    { "id": "title", "type": "start", "label": "标题场景", "sublabel": "TitleScene", "lane": "main", "col": 0, "step": "01", "tag": "入口" },
    { "id": "game", "type": "active", "label": "主场景", "sublabel": "GameScene · 战斗", "lane": "main", "col": 3, "step": "02", "tag": "战斗" },
    { "id": "levelclear", "type": "neutral", "label": "通关结算", "sublabel": "LevelClearScene", "lane": "overlay", "col": 1, "step": "03", "tag": "压栈" },
    { "id": "end", "type": "decision", "label": "结束场景", "sublabel": "EndScene · 胜/负", "lane": "overlay", "col": 2, "step": "04", "tag": "终局" },
    { "id": "quit", "type": "external", "label": "退出游戏", "sublabel": "QuitEvent", "lane": "terminal", "col": 2, "tag": "终态" }
  ],
  "transitions": [
    { "id": "title-game", "from": "title", "to": "game", "label": "开始游戏 · replace", "variant": "emphasis", "labelAt": [325, 148] },
