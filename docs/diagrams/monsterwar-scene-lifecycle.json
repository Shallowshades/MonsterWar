{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "场景流转",
    "subtitle": "SceneManager 栈式切换 · 标题→战斗→结算/结束",
    "locale": "zh-CN",
    "quality_profile": "showcase",
